{
  "name": "sumeshi-github-io",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sumeshi/sumeshi.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/sumeshi/sumeshi.github.io/issues"
  },
  "homepage": "https://github.com/sumeshi/sumeshi.github.io#readme",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "pnpm finalize:404 && pnpm verify:sitemap && pnpm verify:feed && pnpm verify:popular-posts && pnpm verify:seo && pnpm verify:post-content && pnpm verify:async-state && pnpm verify:link-preview",
    "generate:popular-posts": "node scripts/generate-popular-posts.mjs",
    "finalize:404": "node scripts/finalize-404.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:feed": "node scripts/verify-feed.mjs",
    "verify:popular-posts": "node scripts/verify-popular-posts.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:post-content": "node scripts/verify-post-content.mjs",
    "verify:async-state": "node scripts/verify-async-state.mjs",
    "verify:link-preview": "node scripts/verify-link-preview.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sanitize-html": "^2.16.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^12.0.0",
    "mermaid": "^12.2.0",
    "sanitize-html": "^2.18.0"
  }
}
